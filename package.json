    "rust:lock": "node scripts/build.mjs lock"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^7.0.2",
