{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gettic's Comic-Manga reader",
  "version": "../package.json",
  "identifier": "com.gettic.comicmangareader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost comic: http://comic.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost comic: http://comic.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Gettic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
